<?xml version="1.0" encoding="utf-8"?>
<!-- Trafic en clair interdit ; seuls les certificats système sont acceptés. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
